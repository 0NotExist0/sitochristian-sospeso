@echo off
echo Generazione catalogo in corso...
powershell -ExecutionPolicy Bypass -Command "$cartella='Catalogo'; function Get-Tree($path, $relPath) { $dirs = Get-ChildItem -Path $path -Directory; $files = Get-ChildItem -Path $path -File | Where-Object { $_.Extension -match '\.(jpg|jpeg|png)$' }; if ($dirs.Count -eq 0) { [array]$arr = @(); foreach ($f in $files) { $arr += ('{0}/{1}' -f $relPath, $f.Name) }; return ,$arr } else { $obj = @{}; foreach ($d in $dirs) { $sub = Get-Tree -path $d.FullName -relPath ('{0}/{1}' -f $relPath, $d.Name); if ($null -ne $sub) { $obj[$d.Name] = $sub } }; foreach ($f in $files) { $obj[$f.Name] = ('{0}/{1}' -f $relPath, $f.Name) }; return $obj } }; $dati=@{}; if(Test-Path $cartella){ $categorie=Get-ChildItem -Path $cartella -Directory; foreach($cat in $categorie){ $dati[$cat.Name] = Get-Tree -path $cat.FullName -relPath ('{0}/{1}' -f $cartella, $cat.Name) }; $json = $dati | ConvertTo-Json -Depth 10 -Compress; $js = 'window.galleryData = ' + $json + ';'; $js | Out-File -FilePath 'data.js' -Encoding utf8; Write-Host 'Fatto! Albero directory scansionato e data.js generato con successo.' -ForegroundColor Green } else { Write-Host 'Cartella Catalogo non trovata.' -ForegroundColor Red }"
pause